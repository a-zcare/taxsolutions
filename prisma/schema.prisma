generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
}
model Service {
 id String @id
 translations Json
 price Int
 priceType String
 duration Int @default(60)
 active Boolean @default(true)
 bookings Booking[]
}
model Booking {
 id String @id @default(uuid())
 serviceId String
 service Service @relation(fields:[serviceId],references:[id])
 start DateTime @db.Timestamptz(3)
 end DateTime @db.Timestamptz(3)
 name String
 email String
 phone String
 comment String
 locale String
 status String @default("PENDING")
 tokenHash String @unique
 createdAt DateTime @default(now())
 consentAt DateTime @default(now())
}
model Setting {
 key String @id
 value Json
}
model Outbox {
 id String @id @default(uuid())
 to String
 subject String
 text String
 attempts Int @default(0)
 nextAttempt DateTime @default(now())
 sentAt DateTime?
 createdAt DateTime @default(now())
}
model RateLimit {
 key String @id
 count Int
 expiresAt DateTime
}
