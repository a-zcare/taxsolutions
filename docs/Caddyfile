# Replace the domain and run Caddy on the same host as Compose.
# Keep its ACME state persistent and expose 80/443 only as appropriate.
accounting.example.invalid {
    encode zstd gzip
    @documentOcr path /api/workspace/document-ai
    request_body @documentOcr {
      max_size 31457280
    }
    @documentReview path /api/workspace/document-ai/archive/*
    request_body @documentReview {
      max_size 98304
    }
    @otherRequests not path /api/workspace/document-ai /api/workspace/document-ai/archive/*
    request_body @otherRequests {
      max_size 32KB
    }
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy 127.0.0.1:3000 {
        header_up X-Real-IP {remote_host}
    }
    # Do not enable access logs containing cancellation tokens in query strings.
}
