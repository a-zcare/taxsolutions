{
  email {$ACME_EMAIL}
}
{$DOMAIN} {
  encode zstd gzip
  header X-Robots-Tag "noindex, nofollow"
  header Referrer-Policy "no-referrer"
  @documentOcr path /api/workspace/document-ai
  request_body @documentOcr {
    max_size 31457280
  }
  @documentReview path /api/workspace/document-ai/archive/*
  request_body @documentReview {
    max_size 98304
  }
  @otherRequests not path /api/workspace/document-ai /api/workspace/document-ai/archive/*
  request_body @otherRequests {
    max_size 32KB
  }
  reverse_proxy app:3000 {
    header_up X-Real-IP {remote_host}
  }
}
