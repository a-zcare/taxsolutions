APP_IMAGE=taxsolutions:v2
DOMAIN=accounting.example.invalid
ACME_EMAIL=operator@example.invalid
APP_URL=https://accounting.example.invalid
APP_ENV=production
SESSION_SECRET=REPLACE_WITH_RANDOM_48_BYTES_HEX
DATA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTES_BASE64
DB_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX
DB_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
DB_MIGRATION_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
DB_BACKUP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
DATABASE_URL=postgresql://tax_app:REPLACE_WITH_DB_APP_PASSWORD@db:5432/taxsolutions
MIGRATION_DATABASE_URL=postgresql://tax_migrator:REPLACE_WITH_DB_MIGRATION_PASSWORD@db:5432/taxsolutions
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM='TaxSolutions <noreply@example.invalid>'
SMTP_USER=REPLACE
SMTP_PASSWORD=REPLACE
VIDEO_ENABLED_PROVIDERS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Use an independently administered EU host / object store. Never keep the only copy on this VPS.
RESTIC_REPOSITORY=sftp:backup@example.invalid:/encrypted/taxsolutions
RESTIC_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_BACKUP_SECRET
BACKUP_SSH_DIR=./backup-ssh
